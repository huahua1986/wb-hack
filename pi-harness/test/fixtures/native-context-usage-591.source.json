      "sha256": "401ebcf7e47ee138d5ae352b673712522ab069fc5b1f6a2458b43c143ef01115",
      "bytes": 167,
      "source": "function selectHasAssistantChunk(e){return e.messages.some(e=>e.messageType===`assistant`&&(typeof e.content==`string`||Array.isArray(e.content))&&e.content.length>0)}"
